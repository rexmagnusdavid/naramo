{
  "expo": {
    "name": "Naramo",
    "slug": "naramo",
    "scheme": "naramo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.naramo.app"
    },
    "android": {
      "package": "com.naramo.app",
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Naramo needs your location to find nearby places and sort your itinerary."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
